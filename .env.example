# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# ==============================================================================
# Option 1: Google Gemini API (Recommended — 100% Free, no credit card required)
# ==============================================================================
# 1. Get a free API key at: https://aistudio.google.com/
# 2. Uncomment and paste your key below:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Option 2: Groq API (Free fast cloud inference)
# ==============================================================================
# 1. Get a free key at: https://console.groq.com/keys
# 2. Uncomment and set:
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Option 3: OpenRouter Free Models
# ==============================================================================
# 1. Get a free key at: https://openrouter.ai/keys
# 2. Uncomment and set:
# OPENAI_API_KEY=sk-or-v1-your_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-exp:free

# ==============================================================================
# Option 4: Local LLM via Ollama (100% offline & free, no API keys)
# ==============================================================================
# 1. Install Ollama (https://ollama.com) and run: ollama pull llama3.2
# 2. Uncomment below (or leave default http://localhost:11434):
# OLLAMA_URL=http://localhost:11434

